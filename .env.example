APP_NAME=EcoIses
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://biodiversidad-api.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# "warning" evita escribir cientos de líneas por petición; usa "debug" solo para depurar.
LOG_LEVEL=warning

# Base de datos MySQL de Laragon
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecoices
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Colas: hace falta un worker escuchando las DOS colas (ver README):
#   php artisan queue:work --queue=default,species-sync
QUEUE_CONNECTION=database

# "file" es más rápido que "database" en local. En producción, mejor redis.
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@ecoises.test"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend (React) que consume esta API
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# Login con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Fuentes de biodiversidad (7196 = Colombia en iNaturalist)
INATURALIST_BASE_URL=https://api.inaturalist.org/v1
INATURALIST_PLACE_ID=7196
INATURALIST_PREFERRED_PLACE_ID=7196
INATURALIST_RATE_LIMIT=60
EOL_BASE_URL=https://eol.org/api
EOL_TIMEOUT=30
EOL_CACHE_TTL=43200

# IA y audio (opcionales)
GOOGLE_AI_STUDIO_KEY=
ELEVENLABS_API_KEY=
